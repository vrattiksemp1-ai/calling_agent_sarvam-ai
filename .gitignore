# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------- Tool caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pylint.d/

# ---------- Logs / runtime ----------
*.log
nohup.out
*.pid

# ---------- Environment & secrets ----------
.env
.env.local
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.p8

# ---------- Database & uploaded audio ----------
# Local data must never be committed.
data/*.db
data/*.db-*
*.sqlite
*.sqlite3
storage/*
!storage/.gitkeep
!storage/tmp/
storage/tmp/*
!storage/tmp/.gitkeep

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
