# ---------------------------------------------------------------------------
# Sarvam Cloud Lead Agent - environment configuration
# Copy this file to .env and edit values for your machine.
# All secrets/keys stay server-side. Never commit the real .env.
# ---------------------------------------------------------------------------

APP_NAME=Sarvam Cloud Lead Agent
APP_HOST=0.0.0.0
APP_PORT=8021
DEBUG=false

# Database (PostgreSQL). Docker Compose starts Postgres and overrides this
# with host `postgres`. For local uvicorn, run Postgres on localhost or use:
#   docker compose up postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sarvam_leads
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sarvam_leads

# --- Sarvam cloud API (https://www.sarvam.ai) --------------------------------
# Get your key from the Sarvam console. It is sent as the
# "api-subscription-key" header, never in the query string or URL.
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEY=
# STT: saaras:v3 | TTS: bulbul:v3
SARVAM_STT_MODEL=saaras:v3
# "transcribe" for raw transcription, "translate" to translate to English.
SARVAM_STT_MODE=transcribe
# Leave "unknown" for automatic language detection.
SARVAM_LANGUAGE_CODE=unknown
# Persistent Saaras phone STT. Disabled preserves the REST/local-VAD path.
SARVAM_REALTIME_STT_ENABLED=false
SARVAM_REALTIME_STT_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_REALTIME_STT_MODEL=saaras:v3-realtime
# Server endpointing: start sensitivity plus 400 ms end silence.
SARVAM_REALTIME_STT_VAD_THRESHOLD=0.5
SARVAM_REALTIME_STT_SILENCE_MS=400
SARVAM_REALTIME_STT_MIN_SPEECH_MS=100
# Dynamically use 320 ms for complete clauses and 550 ms after conjunctions.
SARVAM_SEMANTIC_ENDPOINTING_ENABLED=true
SARVAM_SEMANTIC_FAST_SILENCE_MS=320
SARVAM_SEMANTIC_SLOW_SILENCE_MS=550
SARVAM_REALTIME_STT_FALLBACK_ENABLED=true
SARVAM_TTS_MODEL=bulbul:v3
# Speaker name (see Sarvam docs for available voices).
SARVAM_TTS_SPEAKER=ritu
# Optional: female | male. Empty = infer from speaker (ritu=female, shubh=male).
SARVAM_TTS_SPEAKER_GENDER=
# TTS target language: one of bn-IN, en-IN, gu-IN, hi-IN, kn-IN, ml-IN,
# mr-IN, od-IN, pa-IN, ta-IN, te-IN. Detected call language maps to this.
SARVAM_TTS_LANGUAGE_CODE=gu-IN
SARVAM_REALTIME_TTS_ENABLED=false
SARVAM_REALTIME_TTS_URL=wss://api.sarvam.ai/v1/text-to-speech/stream
# linear16 and mulaw are supported; linear16 avoids a second lossy conversion.
SARVAM_REALTIME_TTS_CODEC=linear16
SARVAM_REQUEST_TIMEOUT=120

# --- LLM (Sarvam chat API or any OpenAI-compatible endpoint) ------------------
# llm_provider: "sarvam" uses the Sarvam chat API (model sarvam-105b);
# "openai-compatible" points at any OpenAI-compatible server.
LLM_PROVIDER=sarvam
LLM_BASE_URL=https://api.sarvam.ai
LLM_API_KEY=
LLM_MODEL=sarvam-105b
LLM_TIMEOUT=120
LLM_USE_JSON_MODE=true
LLM_STREAMING_ENABLED=false
# Phone / Gather latency (trial path). Keep reasoning off.
PHONE_LLM_REASONING_EFFORT=none
# Optional faster model for phone turns only (openai-compatible example):
# PHONE_LLM_MODEL=gpt-4o-mini
# Or leave empty to keep LLM_MODEL (sarvam-105b on free Sarvam).
PHONE_LLM_MODEL=
PHONE_LLM_MAX_TOKENS=320
PHONE_LLM_TEMPERATURE=0.4
PHONE_PROMPT_COMPACT=true

# Twilio Gather (trial) latency knobs — realistic target ~4–6s, not 2–3s.
# Wait longer before Redirect so more turns return Play+Gather inline.
GATHER_INLINE_BUDGET_SECONDS=5.0
# 0 = no silent Pause before Redirect (saves ~1s on slow turns).
GATHER_POLL_PAUSE_SECONDS=0
# Silence after speech ends before Twilio posts SpeechResult ("auto" or seconds).
GATHER_SPEECH_TIMEOUT=auto
GATHER_TIMEOUT_SECONDS=7
# After N consecutive empty SpeechResults, ask if the caller is still there.
GATHER_EMPTY_PROMPT_AFTER=3
# Keep HTTP TTS streaming after reply text is ready (Gather <Play>).
SARVAM_TTS_STREAMING=true

# --- Application behaviour ---------------------------------------------------
DEFAULT_LANGUAGE=en
MAX_AUDIO_MB=15
RETAIN_AUDIO=false

# --- BDE outbound persona / call facts ---------------------------------------
# Primary facts live in config/call_profile.json (agent, products, contact
# source, default lead). These env vars override the JSON when set.
AGENT_NAME=Shivangi
CALL_PROFILE_PATH=config/call_profile.json
BUSINESS_NAME=Vrattiks
BUSINESS_DESCRIPTION=a technology and software company focused on building AI-powered solutions for businesses and individuals.
# BUSINESS_PRODUCTS=[{"name":"AI voice calling assistant","summary":"..."}]
# CONTACT_SOURCE_CHANNEL=google
# CONTACT_SOURCE_DETAIL=Came across the contact while researching businesses in their field online.
# DEFAULT_LEAD_FULL_NAME=
# DEFAULT_LEAD_COMPANY_NAME=
# DEFAULT_LEAD_JOB_TITLE=
# DEFAULT_LEAD_CITY=
# DEFAULT_LEAD_BUSINESS_TYPE=
# DEFAULT_LEAD_FIELD_NOTE=
# DEFAULT_LEAD_ADDITIONAL_NOTES=
# Soft opening disclosure ("AI assistant") while keeping BDE tone.
DISCLOSE_AI_ASSISTANT=true

# Pipeline tracing: log listen/transcript/LLM/TTS/play with timings + I/O.
# Look for lines starting with `pipeline=` in the server console.
PIPELINE_TRACE_ENABLED=true
PIPELINE_TRACE_MAX_CHARS=2000

# Basic in-memory rate limiting (MVP grade; not for public deployment).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- Real phone calls (Twilio or Exotel, OPTIONAL) ----------------------------
# Existing API clients default to Twilio. Set this to exotel globally, or pass
# {"provider":"exotel"} on an individual POST /api/calls request.
TELEPHONY_PROVIDER=twilio
#
# Twilio -----------------------------------------------------------------------
# Sign up at https://twilio.com (trial includes free credit; trial accounts can
# only call numbers you verify in the Twilio console). Get these from the
# Twilio console -> Account Info and Phone Numbers.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# The "From" number Twilio dials from (your Twilio number). E.164 format.
# TWILIO_PHONE_NUMBER=+17372508034
# Public base URL so Twilio can reach this app's WebSocket (Media Streams
# requires TLS). For testing on a laptop use an ngrok tunnel, e.g.:
#   ngrok http 8021
# then set PUBLIC_BASE_URL=https://abc123.ngrok-free.app
# PUBLIC_BASE_URL=
# Webhook called by Twilio for call status updates. Leave empty to derive from
# PUBLIC_BASE_URL (recommended).
# TWILIO_STATUS_CALLBACK_URL=
#
# Trial-mode controls (Twilio trial accounts can only call numbers that are
# verified in the Twilio console). Verified numbers are fetched live from the
# Twilio "Outgoing Caller IDs" API for the call page dropdown. These extras are
# always allowed as a fallback (works even if the API is unreachable):
# TWILIO_TEST_PHONE_NUMBER=+917048211715
# TWILIO_VERIFIED_NUMBERS=
# Set TWILIO_TRIAL_MODE=false only on a fully provisioned (non-trial) account.
TWILIO_TRIAL_MODE=true
# Timeout for Twilio API requests.
# TWILIO_CALL_TIMEOUT=60
#
# Backwards-compatible aliases (old names still work):
# TWILIO_FROM_NUMBER=+17372508034
# TWILIO_CALL_PUBLIC_BASE_URL=https://abc123.ngrok-free.app
#
# Separate, stricter rate limit for placing calls.
CALL_RATE_LIMIT_PER_MINUTE=5
#
# Exotel Connect Voice AI (Mumbai) ---------------------------------------------
# Direct bidirectional AgentStream calls use the Mumbai API and this app's
# WS /api/calls/exotel/stream endpoint. Keep credentials empty in source files.
EXOTEL_BASE_URL=https://api.in.exotel.com
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# Your Exophone/caller ID.
# EXOTEL_CALLER_ID=
# Optional existing Exotel app ID. When set, calls use Voice v1 and the app's
# bidirectional Voicebot applet; leave empty for direct Connect Voice AI.
# EXOTEL_FLOW_ID=
# Optional terminal-call callback URL.
# EXOTEL_STATUS_CALLBACK_URL=
# EXOTEL_CALL_TIMEOUT=60

# Restricted CORS. Leave empty to serve same-origin only (recommended).
# To allow a specific dev origin use e.g. http://localhost:5173
ALLOWED_ORIGINS=
CORS_ENABLED=false

# --- Cost accounting (INR, display estimates only) ---------------------------
# Estimates are computed from these rates for the UI / logs / exports.
# Sarvam bills per audio hour (STT) and per 10k characters (TTS); LLM bills
# per million tokens. Adjust to match your current plan - invoices from
# Sarvam are authoritative.
STT_RATE_PER_HOUR_INR=30
TTS_RATE_PER_10K_CHARS_INR=30
LLM_INPUT_RATE_PER_MILLION_INR=4
LLM_OUTPUT_RATE_PER_MILLION_INR=16
